
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07111f">
<title>MUBI AI ULTRA</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#07111f;color:#eaf5ff;font-family:Arial,sans-serif}
.app{max-width:900px;margin:auto;padding:16px}
header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #25435e;padding:15px 0}
h1{color:#43e6f5;font-size:21px;margin:0}
small,.muted{color:#91a9bf}
.status{font-size:12px;color:#65e6a6}
.panel{background:#0d1b2d;border:1px solid #24415c;border-radius:15px;padding:14px;margin:14px 0}
#chat{height:48vh;min-height:300px;overflow-y:auto;padding:10px}
.msg{padding:13px;margin:10px 0;border-radius:13px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.5}
.bot{background:#142b42;margin-right:8%}
.user{background:#174d70;margin-left:8%;text-align:left}
.msg img{max-width:100%;max-height:180px;display:block;margin-top:8px;border-radius:10px}
textarea,input{width:100%;padding:13px;background:#071522;color:white;border:1px solid #31516e;border-radius:10px;font-size:15px}
textarea{resize:vertical}
button,.filebtn{background:#17334d;color:white;border:1px solid #31516e;padding:11px 14px;border-radius:10px;cursor:pointer;font-weight:bold}
button.primary{background:#43d9ec;color:#061321;border:0}
button:disabled{opacity:.5}
.row{display:flex;gap:8px;align-items:center}
.row textarea{flex:1}
.tools{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.tools button,.tools label{font-size:12px}
.filebtn{display:inline-block}
input[type=file]{display:none}
details summary{cursor:pointer;color:#43e6f5;font-weight:bold}
.settings{display:grid;gap:10px;margin-top:14px}
.preview{max-width:100%;max-height:130px;border-radius:10px}
@media(max-width:500px){.app{padding:10px}.row button{padding:10px}.status{font-size:10px}}
</style>
</head>
<body>
<div class="app">

<header>
 <div>
  <h1>✦ MUBI AI ULTRA</h1>
  <small>YOUR PERSONAL AI ASSISTANT</small>
 </div>
 <div class="status" id="status">● READY</div>
</header>

<div class="panel">
 <b>Welcome to MUBI AI ULTRA</b>
 <p class="muted">Ask questions in Urdu, Roman Urdu or English. Connect your AI backend in settings to activate real AI answers.</p>
</div>

<div class="panel" id="chat">
 <div class="msg bot">Assalam-o-alaikum! Main MUBI AI ULTRA hoon. Apna sawal likhein!</div>
</div>

<div class="tools">
 <button onclick="startVoice()">🎙 Voice Input</button>
 <button onclick="speakLast()">🔊 Read Answer</button>
 <label class="filebtn" for="imageFile">🖼 Upload Image</label>
 <input id="imageFile" type="file" accept="image/*">
 <button onclick="webSearch()">🌐 Web Search</button>
 <button onclick="clearChat()">🗑 Clear Chat</button>
</div>

<div class="row">
 <textarea id="message" rows="2" placeholder="Message MUBI AI..."></textarea>
 <button class="primary" id="sendBtn" onclick="sendMessage()">SEND ➤</button>
</div>

<div class="panel">
 <details open>
  <summary>⚙ AI BACKEND URL SETTINGS</summary>
  <div class="settings">
   <label>Backend Chat URL</label>
   <input id="backendUrl" type="url" placeholder="https://your-server.com/api/chat">

   <label>Backend Health URL</label>
   <input id="healthUrl" type="url" placeholder="https://your-server.com/health">

   <div class="row">
    <button class="primary" onclick="saveSettings()">SAVE SETTINGS</button>
    <button onclick="testConnection()">TEST CONNECTION</button>
   </div>
   <p class="muted" id="connectionInfo">Backend not connected yet.</p>
  </div>
 </details>
</div>

<div class="panel">
 <b>Features</b>
 <p class="muted">AI Chat • Voice • Image Upload • Web Search • Chat History • Multiple Languages • Coding Help</p>
</div>

<p class="muted" style="text-align:center;font-size:11px">
MUBI AI ULTRA • Browser Edition
</p>
</div>

<script>
const $=id=>document.getElementById(id);
const chat=$("chat");
let selectedImage=null;
let lastAnswer="";
let history=[];

try{
 history=JSON.parse(localStorage.getItem("mubi_history")||"[]");
}catch(e){history=[];}

$("backendUrl").value=localStorage.getItem("mubi_backend")||"";
$("healthUrl").value=localStorage.getItem("mubi_health")||"";

function status(text,color){
 $("status").textContent="● "+text;
 $("status").style.color=color||"#65e6a6";
}

function saveHistory(){
 localStorage.setItem("mubi_history",JSON.stringify(history.slice(-60)));
}

function addMessage(role,text,image){
 const div=document.createElement("div");
 div.className="msg "+role;
 const title=document.createElement("small");
 title.textContent=role==="user"?"YOU":"MUBI AI";
 div.appendChild(title);
 const content=document.createElement("div");
 content.textContent=text;
 div.appendChild(content);
 if(image){
  const img=document.createElement("img");
  img.src=image;
  img.alt="Uploaded image";
  div.appendChild(img);
 }
 chat.appendChild(div);
 chat.scrollTop=chat.scrollHeight;
}

function showMessage(role,text,image){
 history.push({role:role==="bot"?"assistant":"user",content:text});
 saveHistory();
 addMessage(role,text,image);
 if(role==="bot")lastAnswer=text;
}

function renderHistory(){
 chat.innerHTML="";
 if(!history.length){
  addMessage("bot","Assalam-o-alaikum! Main MUBI AI ULTRA hoon. Apna sawal likhein!");
  return;
 }
 history.forEach(m=>addMessage(m.role==="assistant"?"bot":"user",m.content));
}

function saveSettings(){
 const url=$("backendUrl").value.trim();
 const health=$("healthUrl").value.trim();

 if(url&&!url.startsWith("https://")){
  alert("Secure HTTPS backend URL enter karein.");
  return;
 }
 if(health&&!health.startsWith("https://")){
  alert("Secure HTTPS health URL enter karein.");
  return;
 }

 localStorage.setItem("mubi_backend",url);
 localStorage.setItem("mubi_health",health);
 $("connectionInfo").textContent="Settings saved on this device.";
 status("URL SAVED");
}

async function testConnection(){
 saveSettings();
 const url=localStorage.getItem("mubi_health");
 if(!url){
  $("connectionInfo").textContent="Health URL enter karein.";
  return;
 }
 status("TESTING","#f5ca67");
 $("connectionInfo").textContent="Connecting to backend...";
 try{
  const response=await fetch(url,{method:"GET"});
  if(!response.ok)throw new Error("HTTP "+response.status);
  $("connectionInfo").textContent="Backend is reachable. HTTP "+response.status;
  status("SERVER REACHABLE");
 }catch(error){
  $("connectionInfo").textContent="Connection failed: "+error.message+". URL, server and CORS settings check karein.";
  status("CONNECTION ERROR","#ff8585");
 }
}

async function sendMessage(){
 const text=$("message").value.trim();
 if(!text&&!selectedImage)return;
 if(!text&&selectedImage){
  alert("Image ke saath sawal bhi likhein.");
  return;
 }

 const image=selectedImage;
 $("message").value="";
 selectedImage=null;
 $("imageFile").value="";
 showMessage("user",text,image);

 const url=localStorage.getItem("mubi_backend");
 if(!url){
  showMessage("bot","AI backend connected nahi hai. Settings mein backend URL add karein. HTML akela real AI model nahi chala sakta.");
  return;
 }

 $("sendBtn").disabled=true;
 status("THINKING","#f5ca67");
 const waiting=document.createElement("div");
 waiting.className="msg bot";
 waiting.textContent="MUBI AI is thinking...";
 chat.appendChild(waiting);

 try{
  const response=await fetch(url,{
   method:"POST",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify({
    message:text,
    history:history.slice(-20),
    image:image
   })
  });

  if(!response.ok)throw new Error("HTTP "+response.status);
  const data=await response.json();
  waiting.remove();

  const reply=data.reply||data.response||data.message;
  if(typeof reply!=="string")throw new Error("Server response mein reply field nahi hai.");

  showMessage("bot",reply);
  status("ONLINE");
 }catch(error){
  waiting.remove();
  showMessage("bot","Connection error: "+error.message+". Backend URL, CORS aur server check karein.");
  status("ERROR","#ff8585");
 }finally{
  $("sendBtn").disabled=false;
 }
}

$("message").addEventListener("keydown",e=>{
 if(e.key==="Enter"&&!e.shiftKey){
  e.preventDefault();
  sendMessage();
 }
});

$("imageFile").addEventListener("change",e=>{
 const file=e.target.files[0];
 if(!file)return;
 if(!file.type.startsWith("image/")){
  alert("Image file select karein.");
  return;
 }
 if(file.size>3*1024*1024){
  alert("3 MB se chhoti image select karein.");
  return;
 }
 const reader=new FileReader();
 reader.onload=()=>{
  selectedImage=reader.result;
  status("IMAGE READY");
  $("message").placeholder="Image ke baare mein sawal likhein...";
 };
 reader.readAsDataURL(file);
});

function webSearch(){
 const q=$("message").value.trim();
 if(!q){
  alert("Pehle search query likhein.");
  return;
 }
 window.open("https://duckduckgo.com/?q="+encodeURIComponent(q),"_blank");
}

function clearChat(){
 if(!confirm("Chat history clear karni hai?"))return;
 history=[];
 saveHistory();
 renderHistory();
}

function startVoice(){
 const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!Speech){
  alert("Voice input ke liye supported browser, jaise Chrome, try karein.");
  return;
 }
 const recognition=new Speech();
 recognition.lang="ur-PK";
 recognition.onstart=()=>status("LISTENING","#f5ca67");
 recognition.onresult=e=>{
  $("message").value=e.results[0][0].transcript;
  status("READY");
 };
 recognition.onerror=()=>status("VOICE ERROR","#ff8585");
 recognition.onend=()=>status("READY");
 recognition.start();
}

function speakLast(){
 if(!lastAnswer){
  alert("Abhi koi AI answer nahi hai.");
  return;
 }
 if(!("speechSynthesis" in window)){
  alert("Voice output supported nahi.");
  return;
 }
 speechSynthesis.cancel();
 const utterance=new SpeechSynthesisUtterance(lastAnswer);
 utterance.lang="en-US";
 speechSynthesis.speak(utterance);
}

renderHistory();
</script>
</body>
</html>
